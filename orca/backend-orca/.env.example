# ORCA Marine Advisory Platform - Environment Variables Template
# Copy this file to .env and fill in your real values:
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: Distributed session memory via Redis checkpointer (defaults to in-memory MemorySaver)
# REDIS_URL=redis://localhost:6379

# Optional: Live INCOIS PFZ bulk bulletin endpoint URL (defaults to harbor edge snapshot)
# INCOIS_PFZ_URL=https://incois.gov.in/portal/marineinstitute/pfz/pfz_livedata.json
